{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "rootDir": ".",
    "outDir": "dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["server.ts", "controle/**/*.ts", "routes/**/*.ts", "prisma/generated/**/*.ts"],
  "exclude": ["node_modules", "dist"]

}